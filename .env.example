POSTGRES_DB=smartfashion
POSTGRES_USER=smartfashion
POSTGRES_PASSWORD=smartfashion_dev
DATABASE_URL=postgresql://smartfashion:smartfashion_dev@localhost:5432/smartfashion
REDIS_URL=redis://localhost:6379
JWT_SECRET=replace-with-at-least-32-characters
JWT_REFRESH_SECRET=replace-with-another-32-character-secret
AI_SERVICE_URL=http://localhost:8001
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1

# Permanent Decart key: backend only. Get it from https://platform.decart.ai/api-keys
DECART_API_KEY=
DECART_ALLOWED_ORIGINS=http://localhost:3000
DECART_IMAGE_HOSTS=cdn.shopify.com,images.unsplash.com

# GPT-4o mini image RAG (server only)
SHOPAIKEY_API_KEY=
SHOPAIKEY_BASE_URL=https://api.shopaikey.com/v1
SHOPAIKEY_MODEL=gpt-4o-mini
# catalog = the current storefront's 334 products; postgres requires DATABASE_URL.
IMAGE_SEARCH_SOURCE=catalog
